# on the command line instead of the whole URL

git fetch  
# only downloads the data to your local repository it doesn’t automatically merge
# it with any of your work or modify what you’re currently working on. 
# You have to merge it manually into your work when you’re ready.

git pull <remote> <branch>
# for example: git pull origin main  
# automatically fetch and then merge that remote branch into your current branch 
# <remote> is the server you are pulling or pushing to

git push origin <branch-name>

git pull -u origin <branch-name>
git push -u origin <branch-name>
# the -u option configures the current local branch to track the remote branch,
# enabling git pull and git push to work without arguments in the future. 
# git push alone simply uploads commits to the specified remote branch 
# without establishing this persistent tracking relationship.

git remote show <remote>
# to see more information about a particular remote. Use shortname say origin



