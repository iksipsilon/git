# in windows, end of line are marked with two special caracters \r\n (carriage return and line feed)
# on macOS/Linux end of lines are marke just with line feed \n so add input for Linux and true for windows
git config --global core.autocrlf input

git config --global user.name "iksipsilon"   
git config --global user.email "kelamahim@gmail.com"

git config --list	# too see all the current configurations
git config --global -e  # this will open a file to edit all the global settings

git <word_of_interest> --help   # press q to exit



CREATE A NEW REPOSITORY ON THE COMMAND LINE


echo "# git" >> README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main  #in my case not necessary because i have "git config --global init.defaultBranch main"
git remote add origin https://github.com/iksipsilon/git.git
git push -u origin main


…or push an existing repository from the command line

git remote add origin https://github.com/iksipsilon/git.git
