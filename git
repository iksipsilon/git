# if you use --system the settings apply to all users of the current computer
# if you use --global the settings apply to all repositories of the current user 
# if you use --local the settings apply to current repository or the repository in the current folder

git config --system core.editor "vim"   #  othewise it is nano or some other shit

git config --global -e  # this will open a file to edit all the global settings

git config --global user.name "iksipsilon"   
